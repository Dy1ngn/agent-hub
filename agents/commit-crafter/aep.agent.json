{
  "id": "commit-crafter",
  "name": "提交信息生成",
  "description": "读取 Git 改动并生成规范的 commit message，默认只预览，确认后才提交。",
  "runtime": "python",
  "entry": "agent.py",
  "timeoutMs": 600000,
  "model": {
    "protocol": "anthropic",
    "defaultModel": "mimo-v2.6-flash",
    "args": [
      "--model",
      "{{model}}"
    ],
    "offlineArgs": [
      "--offline"
    ],
    "env": {}
  },
  "input": {
    "contentFile": "input/task.txt",
    "args": [
      "--diff-file",
      "input/change.diff",
      "--style",
      "{{params.style}}",
      "--lang",
      "{{params.lang}}",
      "--max-diff-chars",
      "{{params.maxchars}}",
      "--output",
      "{{outputDir}}/report.md"
    ]
  },
  "output": {
    "source": "auto",
    "path": "{{outputDir}}/report.md",
    "format": "markdown"
  },
  "evalsets": [
    "eval/g1-basic.yaml",
    "eval/g2-variation.yaml",
    "eval/g3-edge.yaml",
    "eval/g4-robust.yaml",
    "eval/g5-stability.yaml"
  ]
}