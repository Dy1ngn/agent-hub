{
  "id": "meeting-minutes",
  "name": "会议纪要",
  "description": "解析会议逐字稿，做发言人统计、议题切分、决议与待办抽取，生成中文会议纪要。",
  "runtime": "python",
  "entry": "agent.py",
  "timeoutMs": 600000,
  "model": {
    "protocol": "anthropic",
    "defaultModel": "mimo-v2.6-flash",
    "args": [
      "--model",
      "{{model}}"
    ],
    "offlineArgs": [
      "--offline"
    ],
    "env": {}
  },
  "input": {
    "contentFile": "input/task.txt",
    "args": [
      "input/transcript.txt",
      "--title",
      "{{params.title}}",
      "--date",
      "{{params.date}}",
      "--output",
      "{{outputDir}}/report.md"
    ]
  },
  "output": {
    "source": "file",
    "path": "{{outputDir}}/report.md",
    "format": "markdown",
    "suggestions": {
      "section": "待办事项"
    }
  },
  "evalsets": [
    "eval/g1-basic.yaml",
    "eval/g2-variation.yaml",
    "eval/g3-edge.yaml",
    "eval/g4-robust.yaml",
    "eval/g5-stability.yaml"
  ]
}