    {
      "id": "g4-robust",
      "name": "鲁棒性：畸形数据与非法参数",
      "description": "坏 K 线（字符串价格/负数/缺字段）、非法参数类型等异常输入下优雅降级（规则链路）",
      "judge": false,
      "invocations": 100,
