    {
      "id": "g3-edge",
      "name": "边界情况：数据不足 / 空输入 / 极端参数",
      "description": "K 线不足 30 根、空代码、days=0/500 等边界：给出明确结论而不是崩溃（规则链路）",
      "judge": false,
      "invocations": 100,
      "cases": [
        {
          "id": "g3-edge-{n}",
          "title": "边界输入：{title}",
          "tags": [
            "edge",
            "rule"
          ],
          "input": {
            "kind": "json",
            "goal": "边界输入下给出明确结论",
            "content": "{content}",
            "params": {
              "offline": true
            }
          },
          "repeat": 10,
          "rows": [
            {
              "n": "1",
              "title": "K线只有10天",
              "content": "{\"symbol\": \"600519\", \"seed\": 1, \"days\": 10}"
