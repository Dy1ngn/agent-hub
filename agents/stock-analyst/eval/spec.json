            {
              "n": "3",
              "title": "K线是空数组",
              "content": "{\"symbol\": \"600519\", \"klines\": []}"
            },
            {
              "n": "4",
              "title": "K线含负价格",
              "content": "{\"symbol\": \"600519\", \"klines\": [{\"date\": \"2026-01-01\", \"open\": -1, \"high\": -2, \"low\": -3, \"close\": -4, \"volume\": -5}, {\"date\": \"2026-01-02\", \"open\": -1, \"high\": -2, \"low\": -3, \"close\": -4, \"volume\": -5}, {\"date\": \"2026-01-03\", \"open\": -1, \"high\": -2, \"low\": -3, \"close\": -4, \"volume\": -5}]}"
            },
            {
              "n": "5",
              "title": "seed 是字符串乱码",
              "content": "{\"symbol\": \"600519\", \"seed\": \"abc\", \"days\": 60}"
            },
            {
              "n": "6",
              "title": "days 是负数",
              "content": "{\"symbol\": \"600519\", \"seed\": 6, \"days\": -100}"
            },
            {
              "n": "7",
              "title": "days 是小数字符串",
              "content": "{\"symbol\": \"600519\", \"seed\": 7, \"days\": \"3.14\"}"
            },
            {
              "n": "8",
              "title": "trend 是未知值",
              "content": "{\"symbol\": \"600519\", \"seed\": 8, \"trend\": \"????\"}"
            },
            {
              "n": "9",
              "title": "content 是数组 JSON",
              "content": "[1, 2, 3]"
            },
            {
              "n": "10",
              "title": "fund_score 是乱码",
              "content": "{\"symbol\": \"600519\", \"seed\": 10, \"fund_score\": \"xyz\"}"
            }
          ],
          "gold": {
            "findings": [],
            "checks": [
              {
                "type": "contains",
                "text": "股票分析报告",
                "weight": 2,
                "note": "异常输入仍产出报告"
              },
              {
                "type": "not_contains",
                "text": "Traceback",
                "weight": 2,
                "note": "不允许 Python 崩栈"
              },
              {
                "type": "min_length",
                "value": 80,
                "weight": 1
              }
            ]
          }
        }
