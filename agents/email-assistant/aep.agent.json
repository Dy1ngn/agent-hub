{
  "id": "email-assistant",
  "name": "邮件助手",
  "description": "解析 .eml/.mbox/.txt 邮件，做摘要、优先级判断、待办提取与回复起草，输出中文报告。",
  "runtime": "python",
  "entry": "agent.py",
  "timeoutMs": 600000,
  "model": {
    "protocol": "anthropic",
    "defaultModel": "mimo-v2.6-flash",
    "args": [
      "--model",
      "{{model}}"
    ],
    "offlineArgs": [
      "--offline"
    ],
    "env": {}
  },
  "input": {
    "contentFile": "task.txt",
    "args": [
      "input",
      "--draft",
      "--tone",
      "{{params.tone}}",
      "--output",
      "{{outputDir}}/report.md"
    ]
  },
  "output": {
    "source": "file",
    "path": "{{outputDir}}/report.md",
    "format": "markdown",
    "suggestions": {
      "section": "待办与关键信息"
    }
  },
  "evalsets": [
    "eval/g1-basic.yaml",
    "eval/g2-variation.yaml",
    "eval/g3-edge.yaml",
    "eval/g4-robust.yaml",
    "eval/g5-stability.yaml"
  ]
}