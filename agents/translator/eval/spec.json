            { "file": "input/manual.md", "to": "日语", "from": "中文", "batch": "6000", "src": "# 使用说明书\n\n第一次使用请先充电两小时。长按电源键开机。\n\n如需恢复出厂设置，请在设置菜单中选择“重置”。\n" }
          ],
          "gold": {
            "findings": [],
            "checks": [
              { "type": "contains", "text": "翻译报告", "weight": 1 },
              { "type": "contains", "text": "目标语言：{to}", "weight": 2, "note": "报告元信息记录目标语言" },
              { "type": "contains", "text": "术语表：3 条", "weight": 1 },
