    {
      "id": "g2-variation",
      "name": "输入变体：格式 / 语言对 / 规模 / 参数组合",
      "description": "不同文件格式（md/json/csv/txt）、语言对、文本规模与 batch-chars 参数下的翻译表现（模型链路）",
      "judge": false,
      "invocations": 100,
      "cases": [
        {
          "id": "g2-format-{n}",
          "title": "文件格式变体（{name}）",
          "tags": ["variation", "format"],
          "input": {
            "kind": "text",
            "goal": "不同格式的文件都要正常翻译并记录在报告里",
            "content": "翻译任务：{file} → {to}",
            "files": [
              { "path": "{file}", "content": "{src}" },
              { "path": "input/glossary.json", "content": "{\"数据库\": \"Database\", \"接口\": \"API\", \"负载均衡\": \"Load Balancer\"}" }
            ],
            "params": { "file": "{file}", "to": "{to}", "from": "{from}", "batch": "{batch}" }
          },
          "repeat": 5,
          "rows": [
            { "n": "1", "name": "note.md", "file": "input/note.md", "to": "英语", "from": "中文", "batch": "6000", "src": "# 便签\n\n明天上午十点开会，讨论季度计划。\n" },
            { "n": "2", "name": "data.json", "file": "input/data.json", "to": "英语", "from": "中文", "batch": "6000", "src": "{\n  \"title\": \"季度报表\",\n  \"summary\": \"营收稳步增长\"\n}\n" },
            { "n": "3", "name": "table.csv", "file": "input/table.csv", "to": "英语", "from": "中文", "batch": "6000", "src": "城市,人口\n北京,2189 万\n上海,2487 万\n" },
            { "n": "4", "name": "plain.txt", "file": "input/plain.txt", "to": "英语", "from": "中文", "batch": "6000", "src": "这是一段普通文本，用于验证纯文本翻译流程。\n" }
          ],
          "gold": {
            "findings": [],
            "checks": [
              { "type": "contains", "text": "翻译报告", "weight": 1 },
              { "type": "contains", "text": "`{name}`", "weight": 2, "note": "文件清单记录输入文件名" },
              { "type": "not_contains", "text": "Traceback", "weight": 1 },
              { "type": "min_length", "value": 200, "weight": 1 }
            ]
          }
        },
        {
          "id": "g2-langpair-{n}",
          "title": "语言对变体（{from} → {to}）",
