            "kind": "text",
            "goal": "校对这段中文文本里的错别字与语法问题",
            "content": "{doc}",
            "params": { "lang": "auto", "min": "提示" }
          },
          "repeat": 5,
          "rows": [
            { "title": "短句样本", "rule": "GR001", "doc": "他快速的跑向终点。\n她的认真地态度让人佩服。\n" },
            { "title": "扩展样本", "rule": "GR001", "doc": "他快速的跑向终点。\n她的认真地态度让人佩服。\n这份报告需要认真地核对每一行数据。\n" }
